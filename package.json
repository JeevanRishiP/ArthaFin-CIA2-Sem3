{
  "name": "ai-for-finance",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cp -r src/public/* public/ && mkdir -p dist/public && cp -r src/public/* dist/public/ && mkdir -p dist/db/migrations && cp src/db/*.sql dist/db/ && cp -r src/db/migrations/* dist/db/migrations/",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts,html,css,js --exec ts-node src/server.ts",
    "db:init": "ts-node src/db/migrate.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "db:seed:unified": "ts-node src/db/seeds/unified_seed.ts",
    "test": "ts-node tests/api.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
