# Server Configuration
PORT=3020
APP_URL=http://localhost:3020

# PostgreSQL Configuration (Docker container arthafin_postgres locally OR Cloud DB on Vercel)
# Option A: Single Cloud connection string (Recommended for Vercel, Neon, Supabase)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Option B: Individual host/port credentials (Used locally)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=arthafin_db
DB_USER=postgres
DB_PASSWORD=postgres

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth 2.0 (Optional for production OAuth redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

